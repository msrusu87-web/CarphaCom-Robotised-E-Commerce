# ===========================================
# Storefront Configuration
# ===========================================

# Medusa Backend URL
MEDUSA_BACKEND_URL=http://localhost:9000

# Medusa Publishable API Key (get from Medusa admin → Settings → API Keys)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_key_here

# Store URL (your public-facing domain)
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# Default region
NEXT_PUBLIC_DEFAULT_REGION=ro

# Database password (for direct DB queries - blog, specs, etc.)
DATABASE_PASSWORD=YOUR_DB_PASSWORD

# Stripe (optional)
NEXT_PUBLIC_STRIPE_KEY=

# Revalidation secret (must match admin panel)
REVALIDATE_SECRET=your-revalidate-secret

# Google OAuth (optional - for customer login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
