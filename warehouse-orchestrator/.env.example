# ===========================================
# Warehouse Orchestrator Configuration
# ===========================================

# Gemini AI API Key (for intelligent warehouse operations)
GEMINI_API_KEY=your-gemini-api-key

# Server port
PORT=4000

# Simulation settings
TICK_INTERVAL=500
ROBOT_COUNT=4

# Medusa Backend URL
MEDUSA_URL=http://localhost:9000

# Demo mode (set to true for demo without real order processing)
DEMO_MODE=false

# Database connection
DATABASE_URL=postgresql://medusa:YOUR_DB_PASSWORD@localhost:5432/medusa_store
