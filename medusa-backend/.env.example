# ===========================================
# Medusa Backend Configuration
# ===========================================

# Database
DATABASE_URL=postgres://medusa:YOUR_DB_PASSWORD@localhost:5432/medusa_store

# Redis
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@localhost:6379

# Secrets (generate random strings for production)
JWT_SECRET=your-jwt-secret-here
COOKIE_SECRET=your-cookie-secret-here

# CORS - Set to your domain
STORE_CORS=https://your-domain.com,http://localhost:8000
ADMIN_CORS=https://your-domain.com,http://localhost:3000
AUTH_CORS=https://your-domain.com,http://localhost:3000

# Medusa
MEDUSA_ADMIN_ONBOARDING_TYPE=nextjs
MEDUSA_BACKEND_URL=https://your-domain.com

# PNI B2B API Configuration (optional - for supplier integration)
PNI_API_URL=https://b2b.mypni.com/api/v1
PNI_USERNAME=your-pni-username
PNI_PASSWORD=your-pni-password

# Database password fallback
DATABASE_PASSWORD=YOUR_DB_PASSWORD
